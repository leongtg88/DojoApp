# Supabase Postgres
# Pooler para la aplicacion en Vercel (puerto 6543)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require&uselibpqcompat=true"
# Conexion directa para migraciones Prisma (puerto 5432)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true"

# Auth.js
# Genera un secreto fuerte (>=32 bytes): `openssl rand -base64 32`
# NO uses el valor de ejemplo. Debe ser idéntico entre Production y Preview en Vercel.
AUTH_SECRET="genera-un-secreto-largo"
AUTH_TRUST_HOST="true"

# Resend
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Tosei Gusoku <no-reply@tu-dominio.com>"

# Supabase Storage (documentos privados: fotos, cédulas, pasaportes)
# URL del proyecto: https://app.supabase.com/project/PROJECT_REF → Project Settings → API
SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Service role key (Project Settings → API → Service Role, secret; no exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxx"
# Nombre del bucket de Storage donde se guardan los documentos (debe existir en Supabase)
SUPABASE_DOCUMENTS_BUCKET="docs-inscripciones"

NEXTDOJO_APP="http://localhost:3000"

# Credenciales del seed. Vacías → se genera una contraseña aleatoria por cuenta
# (se imprime una sola vez al ejecutar el seed). En entornos que no sean
# desarrollo, defínelas con valores reales.
SEED_OWNER_PASSWORD=""
SEED_ADMIN_PASSWORD=""
SEED_INSTRUCTOR_PASSWORD=""
SEED_STUDENT_PASSWORD=""

# n8n (opcional): URL del webhook que recibe cada inscripción creada y cada alumno convertido.
# Si está vacía, la aplicación no envía nada a n8n.
N8N_WEBHOOK_URL=""

# Meta Pixel (Facebook Ads)
NEXT_PUBLIC_META_PIXEL_ID=""

# Google Analytics 4
NEXT_PUBLIC_GA_ID=""

# Web Push (notificaciones del navegador/PWA)
# Genera las claves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@dominio.com"

# Telegram (avisos de nuevas inscripciones)
# Token de @BotFather y uno o más chat IDs separados por coma (un grupo usa id negativo)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_IDS=""
AUTH_SECRET="genera-un-secreto-largo"