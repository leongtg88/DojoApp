// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== Organización ====================
model School {
  id               String            @id @default(cuid())
  name             String
  branches         Branch[]
  users            User[]
  students         Student[]
  enrollments      Enrollment[]
  beltRanks        BeltRank[]
  techniques       Technique[]
  achievementTypes AchievementType[]
  plans            Plan[]
  holidays         Holiday[]
  examConvocations ExamConvocation[]
  auditLogs        AuditLog[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Branch {
  id          String       @id @default(cuid())
  name        String
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id])
  users       User[]
  students    Student[]
  enrollments Enrollment[]
  classes     Class[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ==================== Usuarios y roles ====================
enum Role {
  STUDENT
  GUARDIAN
  INSTRUCTOR
  SCHOOL_ADMIN
  SUPERADMIN
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum EnrollmentStatus {
  PENDING
  CONTACTED
  ENROLLED
  REJECTED
}

enum ClassEnrollmentStatus {
  ACTIVE
  PAUSED
  ENDED
  COMPLETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  emailVerified           DateTime?
  passwordHash            String?
  sessionVersion          Int                      @default(0) // invalida sesiones JWT al cambiar password
  name                    String?
  phone                   String?
  roles                   Role[]                   @default([]) // todos los roles del usuario (multirol)
  schoolId                String?
  school                  School?                  @relation(fields: [schoolId], references: [id])
  branchId                String?
  branch                  Branch?                  @relation(fields: [branchId], references: [id])
  instructorProfile       InstructorProfile?
  studentProfile          Student?
  guardians               GuardianStudent[]        @relation("guardian")
  guardianOfStudents      Student[]                @relation("primaryGuardian")
  rankPromotions          StudentRankHistory[]     @relation("rankPromoter")
  techniqueEvaluations    TechniqueEvaluation[]    @relation("techniqueEvaluator")
  techniquesApproved      StudentTechnique[]       @relation("techniqueApprovedBy")
  achievementsApproved    StudentAchievement[]     @relation("achievementApprovedBy")
  fitnessReportsApproved  FitnessReport[]          @relation("fitnessApprovedBy")
  attendanceConfirmations Attendance[]             @relation("attendanceConfirmer")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  acceptedInvitations     StudentInvitationToken[]
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  auditLogs               AuditLog[]
  classes                 Class[]                  @relation("instructor")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([schoolId])
  @@index([branchId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique // hash del token
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique // hash del token
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model StudentInvitationToken {
  id           String    @id @default(cuid())
  token        String    @unique // hash del token
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  email        String // correo destino de la invitación
  expiresAt    DateTime
  usedAt       DateTime?
  usedByUserId String? // id del User que aceptó la invitación
  usedBy       User?     @relation(fields: [usedByUserId], references: [id])
  createdAt    DateTime  @default(now())

  @@index([studentId])
  @@index([expiresAt])
}

model InstructorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  bio         String?
  specialties String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Student {
  id                  String                   @id @default(cuid())
  userId              String?                  @unique // si el estudiante tiene cuenta propia (mayor de edad)
  guardianId          String? // referencia al User tutor (si es menor)
  schoolId            String
  branchId            String
  firstName           String
  lastName            String
  dateOfBirth         DateTime
  gender              Gender? // género declarado
  email               String? // correo de contacto para la invitación de acceso
  contactPhone        String?
  medicalInfo         String?
  emergencyContact    String?
  giSize              String? // talla de karategi (uniforme)
  beltSize            String? // talla de cinturón
  enrollmentDate      DateTime                 @default(now())
  memberNumber        String?                  @unique // matrícula KYU-YYYY-NNN
  status              StudentStatus            @default(ACTIVE)
  currentRank         String? // nombre denormalizado del grado actual (fallback)
  currentRankId       String? // grado actual (FK al catálogo BeltRank)
  currentRankRef      BeltRank?                @relation("studentCurrentRank", fields: [currentRankId], references: [id], onDelete: SetNull)
  photoKey            String? // clave en Supabase Storage
  registrationData    Json?
  planId              String?
  plan                Plan?                    @relation(fields: [planId], references: [id])
  planStartDate       DateTime? // fecha de inicio en el plan actual (para historial)
  scholarshipType     ScholarshipType          @default(NONE)
  scholarshipNote     String? // razón escrita de la beca
  isCompetitor        Boolean                  @default(false)
  school              School                   @relation(fields: [schoolId], references: [id])
  branch              Branch                   @relation(fields: [branchId], references: [id])
  user                User?                    @relation(fields: [userId], references: [id])
  guardian            User?                    @relation("primaryGuardian", fields: [guardianId], references: [id])
  guardians           GuardianStudent[]        @relation("student")
  enrollments         Enrollment[]
  attendances         Attendance[]
  achievements        StudentAchievement[]
  techniques          StudentTechnique[]
  fitnessReports      FitnessReport[]
  classEnrollments    ClassEnrollment[]
  rankHistory         StudentRankHistory[]
  enrollmentApplicant EnrollmentApplicant?
  invitationTokens    StudentInvitationToken[]
  documents           StudentDocument[]
  notifications       Notification[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([planId])
  @@index([scholarshipType])
  @@index([currentRankId])
  @@index([branchId])
  @@index([schoolId])
  @@index([status])
  @@index([branchId, status])
}

// Relación muchos a muchos entre tutores y estudiantes
model GuardianStudent {
  guardianId   String
  studentId    String
  guardian     User     @relation("guardian", fields: [guardianId], references: [id])
  student      Student  @relation("student", fields: [studentId], references: [id])
  relationship String? // padre, madre, tutor legal...
  createdAt    DateTime @default(now())

  @@id([guardianId, studentId])
}

// ==================== Inscripciones ====================
enum EnrollmentOrigin {
  FORM
  ASSISTANT
}

enum StudentDocumentType {
  PROFILE_PHOTO
  IDENTITY
  BIRTH_CERTIFICATE
  PASSPORT
  MEDICAL_CERTIFICATE
  OTHER
}

enum StudentDocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum TechniqueCategory {
  KIHON
  KATA
  KUMITE
  BUNKAI
}

model Enrollment {
  id               String                @id @default(cuid())
  origin           EnrollmentOrigin
  schoolId         String?
  school           School?               @relation(fields: [schoolId], references: [id])
  branchId         String?
  branch           Branch?               @relation(fields: [branchId], references: [id])
  applicantName    String?
  interest         String? // qué le interesa (karate, defensa personal...)
  schedule         String? // horario preferido
  quote            String? // cotización dada
  studentId        String? // si ya se creó el expediente
  student          Student?              @relation(fields: [studentId], references: [id])
  contactEmail     String
  contactPhone     String?
  status           EnrollmentStatus      @default(PENDING)
  notes            String?
  registrationData Json?
  applicants       EnrollmentApplicant[]
  documents        StudentDocument[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([contactEmail, status]) // control básico de duplicados
  @@index([status])
  @@index([branchId, status])
}

model EnrollmentApplicant {
  id           String            @id @default(cuid())
  enrollmentId String
  studentId    String?           @unique
  name         String
  dateOfBirth  DateTime
  profileData  Json
  enrollment   Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student      Student?          @relation(fields: [studentId], references: [id])
  documents    StudentDocument[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([enrollmentId])
}

model StudentDocument {
  id           String                @id @default(cuid())
  enrollmentId String?
  applicantId  String?
  studentId    String?
  type         StudentDocumentType
  status       StudentDocumentStatus @default(PENDING)
  fileName     String
  storageKey   String                @unique
  mimeType     String
  fileSize     Int
  reviewNotes  String?
  reviewedAt   DateTime?
  enrollment   Enrollment?           @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  applicant    EnrollmentApplicant?  @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  student      Student?              @relation(fields: [studentId], references: [id], onDelete: SetNull)
  uploadedAt   DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([applicantId])
  @@index([studentId, status])
}

// ==================== Rangos y técnicas ====================
enum Program {
  ADULT // 18+
  YOUTH // 11-17
}

// Día habitual de convocatoria a examen de grado (principiantes sábado, avanzados domingo).
enum ExamDay {
  SATURDAY
  SUNDAY
}

model BeltRank {
  id                      String               @id @default(cuid())
  program                 Program              @default(ADULT)
  name                    String // Blanco, Amarillo, etc.
  kyuDan                  String? // e.g. "10TH KYU", "SHODAN"
  japaneseName            String? // e.g. "Ju-kyu", "Shodan"
  kanji                   String? // e.g. "十級", "初段"
  order                   Int // orden secuencial dentro del programa
  beltColor               String? // color del cinturón (hex)
  beltSecondaryColor      String? // color secundario (franjas)
  isMaximumRank           Boolean              @default(false)
  estimatedDurationMonths Int? // duración estimada del grado
  description             String?
  schoolId                String?
  minMonths               Int? // permanencia mínima para examen
  maxMonths               Int? // permanencia máxima estimada para el grado
  minAttendancePercent    Int? // asistencia mínima exigida para examen
  examDay                 ExamDay? // día habitual de convocatoria (null = sin examen definido)
  school                  School?              @relation(fields: [schoolId], references: [id])
  katas                   BeltRankKata[]
  promotions              StudentRankHistory[]
  currentRankStudents     Student[]            @relation("studentCurrentRank")
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
}

// Katas requeridas por grado (catálogo M:N). Reutiliza Technique con category KATA.
model BeltRankKata {
  beltRankId String
  kataId     String
  order      Int       @default(0) // posición dentro del grado
  beltRank   BeltRank  @relation(fields: [beltRankId], references: [id], onDelete: Cascade)
  kata       Technique @relation(fields: [kataId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@id([beltRankId, kataId])
  @@index([kataId])
}

model StudentRankHistory {
  id           String   @id @default(cuid())
  studentId    String
  beltRankId   String
  promotedBy   String?
  promotedAt   DateTime @default(now())
  examinerName String? // sensei sinodal / evaluador del examen
  notes        String?
  student      Student  @relation(fields: [studentId], references: [id])
  beltRank     BeltRank @relation(fields: [beltRankId], references: [id])
  promoter     User?    @relation("rankPromoter", fields: [promotedBy], references: [id])
  createdAt    DateTime @default(now())

  @@index([studentId, promotedAt])
  @@index([beltRankId])
}

model Technique {
  id               String             @id @default(cuid())
  name             String // nombre de la técnica (kata, kihon, etc.)
  japaneseName     String?
  kanji            String?
  description      String?
  category         TechniqueCategory  @default(KIHON)
  order            Int                @default(0) // orden pedagógico dentro del grado
  movementsCount   Int? // katas: movimientos; kumite: pasos/técnicas; bunkai: secuencias
  embusen          String? // patrón de desplazamiento (I, H, Cruz...) — solo kata
  difficulty       String? // Básica, Intermedia, Avanzada
  videoUrl         String?
  // Campos específicos por categoría
  repetitionsCount Int? // kihon: número de repeticiones
  stance           String? // kihon: posición / guardia (Zenkutsu Dachi...)
  level            String? // kihon: nivel (Jodan, Chudan, Gedan)
  kumiteType       String? // kumite: Kihon Ippon, Jiyu Ippon, Jiyu Kumite, Shiai...
  distance         String? // kumite: distancia (Toma, Chika Ma, Ma...)
  role             String? // kumite: rol (Aka, Ao, Tori, Uke)
  applicationType  String? // bunkai: tipo de aplicación (Defensa personal, Proyección...)
  originKataId     String? // bunkai: kata de origen
  originKata       Technique?         @relation("BunkaiOrigin", fields: [originKataId], references: [id], onDelete: SetNull)
  bunkaiApplications Technique[]      @relation("BunkaiOrigin")
  schoolId         String?
  school           School?            @relation(fields: [schoolId], references: [id])
  beltRankKatas    BeltRankKata[]
  students         StudentTechnique[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([originKataId])
}

model StudentTechnique {
  id               String               @id @default(cuid())
  studentId        String
  techniqueId      String
  student          Student              @relation(fields: [studentId], references: [id])
  technique        Technique            @relation(fields: [techniqueId], references: [id])
  approved         Boolean              @default(false)
  approvedBy       String?
  approvedByUser   User?                @relation("techniqueApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  inPractice       Boolean              @default(false)
  practiceHours    Float                @default(0)
  practiceRepetitions Int               @default(0) // total acumulado de repeticiones registradas
  lastPracticeDate DateTime?
  notes            String?
  evaluation       TechniqueEvaluation?
  practiceLogs     TechniquePracticeLog[]
  createdAt        DateTime             @default(now())

  @@unique([studentId, techniqueId])
  @@index([approvedBy])
}

enum PracticePlace {
  DOJO
  FUERA
}

model TechniquePracticeLog {
  id                 String           @id @default(cuid())
  studentTechniqueId String
  studentTechnique   StudentTechnique @relation(fields: [studentTechniqueId], references: [id], onDelete: Cascade)
  date               DateTime         @default(now())
  repetitions        Int
  place              PracticePlace    @default(DOJO)
  notes              String?
  attendanceId       String?
  attendance         Attendance?      @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())

  @@index([studentTechniqueId, date])
  @@index([attendanceId])
}

model TechniqueEvaluation {
  id                 String           @id @default(cuid())
  studentTechniqueId String           @unique
  score              Int
  feedback           String?
  evaluatedBy        String
  evaluatedAt        DateTime         @default(now())
  studentTechnique   StudentTechnique @relation(fields: [studentTechniqueId], references: [id], onDelete: Cascade)
  evaluator          User             @relation("techniqueEvaluator", fields: [evaluatedBy], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([evaluatedBy, evaluatedAt])
}

// ==================== Clases y asistencia ====================
enum ClassAudience {
  ADULTS
  CHILDREN
  MIXED
}

model Plan {
  id           String    @id @default(cuid())
  name         String
  description  String?
  monthlyHours Float     @default(0) // horas mensuales incluidas
  price        Decimal?  @db.Decimal(10, 2) // valor numérico
  currency     String    @default("DOP") // moneda del precio (código ISO 4217)
  isUnlimited  Boolean   @default(false)
  active       Boolean   @default(true)
  sortOrder    Int       @default(0)
  schoolId     String?
  school       School?   @relation(fields: [schoolId], references: [id])
  students     Student[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active, sortOrder])
}

model Class {
  id           String            @id @default(cuid())
  name         String
  description  String?
  audience     ClassAudience     @default(MIXED)
  active       Boolean           @default(true)
  branchId     String
  branch       Branch            @relation(fields: [branchId], references: [id])
  instructorId String?
  instructor   User?             @relation("instructor", fields: [instructorId], references: [id])
  dayOfWeek    Int // 0=domingo, 1=lunes...
  startTime    DateTime          @db.Time // hora de inicio
  endTime      DateTime          @db.Time // hora de fin
  sessions     ClassSession[]
  enrollments  ClassEnrollment[]
  attendances  Attendance[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([branchId, active])
}

model ClassEnrollment {
  id         String                @id @default(cuid())
  classId    String
  studentId  String
  status     ClassEnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime              @default(now())
  endedAt    DateTime?
  notes      String?
  class      Class                 @relation(fields: [classId], references: [id])
  student    Student               @relation(fields: [studentId], references: [id])
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([classId, studentId])
  @@index([studentId, status])
  @@index([classId, status])
}

model ClassSession {
  id          String       @id @default(cuid())
  classId     String
  class       Class        @relation(fields: [classId], references: [id])
  date        DateTime
  notes       String?
  attendances Attendance[]
  createdAt   DateTime     @default(now())

  @@unique([classId, date])
}

enum AttendanceStatus {
  PENDING
  CONFIRMED
  REJECTED
  JUSTIFIED
}

enum ScholarshipType {
  NONE
  ECONOMIC
  MERIT
  COMPETITOR
}

model Attendance {
  id              String           @id @default(cuid())
  sessionId       String?
  session         ClassSession?    @relation(fields: [sessionId], references: [id])
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id])
  date            DateTime         @default(now()) // fecha del registro (punch-in o pase de lista)
  present         Boolean          @default(true)
  hoursTrained    Float            @default(1)
  sessionType     String?
  status          AttendanceStatus @default(PENDING)
  classId         String? // horario en el que asistió efectivamente
  class           Class?           @relation(fields: [classId], references: [id])
  isOutOfSchedule Boolean          @default(false) // asistió a un horario distinto al de su referencia
  recoveredById   String?          @unique // asistencia (fuera de horario) que recuperó una falta justificada
  recoveredBy     Attendance?      @relation("recovery", fields: [recoveredById], references: [id])
  recovery        Attendance?      @relation("recovery")
  punchedAt       DateTime         @default(now())
  confirmedAt     DateTime?
  confirmedById   String?
  confirmedBy     User?            @relation("attendanceConfirmer", fields: [confirmedById], references: [id])
  notes           String?
  practiceLogs    TechniquePracticeLog[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId, date])
  @@index([status, date])
  @@index([classId])
  @@index([isOutOfSchedule])
}

// ==================== Logros y reportes ====================
model AchievementType {
  id           String               @id @default(cuid())
  name         String // "Cinturón amarillo", "Torneo", etc.
  description  String?
  schoolId     String?
  school       School?              @relation(fields: [schoolId], references: [id])
  achievements StudentAchievement[]
  createdAt    DateTime             @default(now())

  @@index([schoolId])
}

model StudentAchievement {
  id             String          @id @default(cuid())
  studentId      String
  student        Student         @relation(fields: [studentId], references: [id])
  typeId         String
  type           AchievementType @relation(fields: [typeId], references: [id])
  evidenceKey    String? // clave en Storage
  approvedBy     String?
  approvedByUser User?           @relation("achievementApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  comment        String?
  status         ApprovalStatus  @default(PENDING)
  achievedAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())

  @@index([approvedBy])
}

model FitnessReport {
  id             String         @id @default(cuid())
  studentId      String
  student        Student        @relation(fields: [studentId], references: [id])
  report         String // texto del auto-reporte
  evidenceKey    String?
  approvedBy     String?
  approvedByUser User?          @relation("fitnessApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  comment        String?
  status         ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())

  @@index([approvedBy])
}

// ==================== Notificaciones ====================
enum NotificationType {
  TECHNIQUES_ASSIGNED
  TECHNIQUES_REMOVED
  RANK_PROMOTED
  KATAS_UNLOCKED
  CLASS_ENROLLED
  CLASS_REMOVED
  PLAN_ASSIGNED
  SCHOLARSHIP_ASSIGNED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  DOCUMENT_UPLOADED
  ATTENDANCE_CONFIRMED
  ATTENDANCE_PUNCHED
  TECHNIQUE_APPROVED
  TECHNIQUE_EVALUATED
}

enum NotificationPriority {
  INFO
  ACTION
  URGENT
}

model Notification {
  id        String               @id @default(cuid())
  userId    String // destinatario (alumno o tutor)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId String? // alumno referido por la notificación
  student   Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  type      NotificationType
  title     String
  body      String
  link      String? // ruta interna del portal
  data      Json? // metadatos (techniqueIds, beltRankId, classId...)
  priority  NotificationPriority @default(INFO)
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([studentId])
}

// ==================== Web Push ====================
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ==================== Calendario dojo (feriados y convocatorias) ====================
model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime // fecha observada (día no laborable)
  recurring Boolean  @default(false) // se repite cada año en la misma fecha
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())

  @@unique([date, schoolId])
  @@index([schoolId, date])
}

// Fecha real confirmada de examen. Si no hay una para el cuatrimestre del alumno,
// se muestra la fecha tentativa calculada desde BeltRank.examDay.
model ExamConvocation {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date      DateTime
  examDay   ExamDay
  label     String?
  notes     String?
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, date, examDay])
  @@index([schoolId, date])
}

// Tabla para rate limiting simple por ventana fija. `key` identifica la acción
// (p. ej. "login:{ip}", "forgot:{email}") y `windowStart` es el inicio de la
// ventana actual; `count` acumula los intentos en esa ventana.
model ApiUsage {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(1)
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([key])
}

// Trazabilidad de acciones sensibles del staff (exports, borrados): soporta
// repudio/responsabilidad. El `detail` es un JSON opcional con el contexto.
model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([schoolId, createdAt])
  @@index([action])
}
