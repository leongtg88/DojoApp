{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "**/.env*": "deny",
      "**/.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "**/.env*": "deny",
      "**/.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "cat */.env*": "deny",
      "type */.env*": "deny"
    }
  },
  "mcp": {
    "graphify": {
      "type": "local",
      "command": [
        "graphify-mcp",
        "nextfrontend/graphify-out/graph.json"
      ],
      "enabled": true
    }
  }
}
